# Loaded by Next.js, and by drizzle-kit / the seed scripts via src/db/load-env.ts.
# .env.local wins over .env — put the real connection string there, not here.
DATABASE_URL=postgresql://user@localhost:5432/mb_tasks

AUTH_SECRET=replace-with-openssl-rand-hex-32
APP_TIMEZONE=Asia/Manila
NEXT_PUBLIC_DEMO_ROLE_SWITCHER=true

# Optional. `pnpm test` builds and drops this database on every run, so it must
# be local and its name must end in _test — the harness refuses otherwise.
# TEST_DATABASE_URL=postgresql://user@localhost:5432/mb_tasks_test

# Cloudflare R2 for task attachments. Leave unset and uploads go to ./.uploads
# on disk, which is what development and CI use.
# Use the jurisdiction endpoint if the bucket is not in the default region
# (an EU bucket answers on <account>.eu.r2.cloudflarestorage.com).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
